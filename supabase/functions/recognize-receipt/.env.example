# Supabase Edge Function secrets (NOT Vite / NOT Netlify VITE_*).
# Set in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Or:    supabase secrets set OPENAI_API_KEY=sk-...
#
# Bolt "Missing secrets" also looks for this exact name when scanning
# supabase/functions/** — add OPENAI_API_KEY in Bolt Secrets to clear the warning.
# That Bolt value does NOT automatically sync to Supabase or Netlify.
OPENAI_API_KEY=
